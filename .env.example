# ============================================================
# MedCore — plantilla de variables de entorno
# Copiar a .env y completar. El archivo .env NUNCA se versiona.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=medcore
POSTGRES_PASSWORD=medcore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- MongoDB ----------
MONGO_USER=medcore
MONGO_PASSWORD=medcore
MONGO_HOST=mongodb
MONGO_PORT=27017

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------- JWT ----------
# En produccion generar con: openssl rand -base64 64
JWT_SECRET=clave-de-desarrollo-cambiar-en-produccion-minimo-64-caracteres-abcdef
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------- Spring Cloud ----------
SPRING_PROFILES_ACTIVE=local
SPRING_CLOUD_CONFIG_URI=http://config-server:8888
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://eureka-server:8761/eureka/

# ---------- Frontend ----------
# Origen permitido por CORS en el api-gateway.
# Local: http://localhost:3000 — Produccion: la URL de Vercel.
FRONTEND_ORIGIN=http://localhost:3000

# URL del backend que consume el frontend.
# Local: http://localhost:8080 — Produccion: el dominio estatico de ngrok.
VITE_API_BASE_URL=http://localhost:8080

# ---------- Correo (notification-service) ----------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- JVM ----------
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
